# 复制为 host.env 后按实际访问地址修改

# —— HTTP（仅内网调试，公网不安全）——
# ONYKA_PUBLIC_URL=http://YOUR_SERVER_IP:3000
# CORS_ORIGIN=http://YOUR_SERVER_IP:3000,http://127.0.0.1:3000
# FRONTEND_URL=http://YOUR_SERVER_IP:3000
# COOKIE_SECURE=false

# —— HTTPS（推荐：传输加密，浏览器自动解密）——
# 需域名 + 宝塔/Nginx 反代 127.0.0.1:3000，见 README-deploy.txt
ONYKA_PUBLIC_URL=https://notes.example.com
CORS_ORIGIN=https://notes.example.com
FRONTEND_URL=https://notes.example.com
COOKIE_SECURE=true
# TRUST_PROXY=1
